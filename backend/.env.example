# Copy to .env and fill in. Never commit .env.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true only when running behind exactly one reverse proxy (nginx, Render, Railway...).
TRUST_PROXY=false

# Rate limit storage. memory:// is fine for one process; use redis://... in production.
RATELIMIT_STORAGE_URI=memory://

# SMTP for the contact form. With Gmail, use an App Password (not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Where contact messages are delivered.
CONTACT_RECIPIENT=
# Sender address shown on the notification email (usually SMTP_USERNAME).
CONTACT_SENDER=

# When true and SMTP is not configured, messages are logged instead of sent.
MAIL_DRY_RUN=true
